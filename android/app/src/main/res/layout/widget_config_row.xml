<?xml version="1.0" encoding="utf-8"?>
<!-- One counter in that list: its colour, its name, and the group it's in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp"
    android:paddingVertical="8dp">
    <ImageView
        android:id="@+id/widget_config_color"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_button"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_config_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/widget_config_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>
