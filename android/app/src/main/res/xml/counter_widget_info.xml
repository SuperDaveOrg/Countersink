<?xml version="1.0" encoding="utf-8"?>
<!-- The counter widget: one cell and up, resizable both ways. It asks which
     counter when added, and can be asked again later. It is never redrawn on
     a timer; CounterWidget redraws it when a count changes and when a new
     day begins. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.superdavelab.countersink.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_empty"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="40dp"
    android:minWidth="110dp"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"/>
